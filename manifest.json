{
  "manifest_version": 3,
  "name": "Capybara Vuln Check",
  "version": "0.2.0",
  "description": "Capybara 0.-.0, Vulnerability & Security Scanner (incl. CVE, DOM & Session Security).",
  "action": {
    "default_title": "Capybara Vuln Check",
    "default_popup": "src/popup.html",
    "default_icon": "assets/icons/capybara.svg"
  },
  "icons": {
    "48": "assets/icons/capybara.svg",
    "96": "assets/icons/capybara.svg"
  },
  "permissions": [
    "activeTab",
    "webRequest",
    "storage",
    "scripting",
    "cookies"
  ],
  "host_permissions": [
    "<all_urls>",
    "https://services.nvd.nist.gov/*",
    "https://api.osv.dev/*",
    "https://www.cisa.gov/*",
    "https://api.first.org/*"
  ],
  "background": {
    "service_worker": "src/background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["src/content_script.js"]
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "capybara-vuln-check@local",
      "strict_min_version": "109.0"
    }
  }
}
