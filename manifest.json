{
  "manifest_version": 2,
  "name": "Capybara Vuln Check",
  "version": "0.1.0",
  "description": "Passive Hinweise auf Serverdienste und passende CVEs.",
  "browser_action": {
    "default_title": "Capybara Vuln Check",
    "default_popup": "popup.html",
    "default_icon": "icons/capybara.svg"
  },
  "icons": {
    "48": "icons/capybara.svg",
    "96": "icons/capybara.svg"
  },
  "permissions": [
    "activeTab",
    "webRequest",
    "https://services.nvd.nist.gov/*"
  ],
  "optional_permissions": [
    "*://*/*"
  ],
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "capybara-vuln-check@local",
      "strict_min_version": "109.0"
    }
  }
}
