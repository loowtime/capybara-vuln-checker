{
  "manifest_version": 3,
  "name": "Capybara Vuln Check",
  "version": "0.2.0",
  "description": "Passive Hinweise auf Serverdienste und passende CVEs.",
  "browser_action": {
    "default_title": "Capybara Vuln Check",
    "default_popup": "src/popup.html",
    "default_icon": "assets/icons/capybara.svg"
  },
  "icons": {
    "48": "assets/icons/capybara.svg",
    "96": "assets/icons/capybara.svg"
  },
  "permissions": [
    "activeTab",
    "webRequest",
    "https://services.nvd.nist.gov/*",
    "https://api.osv.dev/*",
    "https://www.cisa.gov/*",
    "https://api.first.org/*",
    "storage"
  ],
  "optional_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "scripts": ["src/background.js"],
    "service_worker": "src/background.js"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "capybara-vuln-check@local",
      "strict_min_version": "109.0"
    }
  }
}
